  "narrative": {
    "northStar": "The Instrument Beside the Specimen",
    "overview": "The brain owns the screen. It sits full-bleed on a near-black stage, and everything textual is a docked instrument beside it: one 400px panel inset 16px from the edge, one small legend, one drag/zoom hint. The world is a Linear-derived dark theme pinned by the user. Depth is tonal (three surfaces a few percent apart), edges are white-alpha inset rings, and the only chroma on screen is data: the evidence-strength ramp on the points.",
    "keyCharacteristics": [
      "Stage #08090a, panel #0f1011, raised #161718; no light surfaces.",
      "Chrome is achromatic. Color appears only as evidence strength on points, list badges and the legend.",
      "Rings, not fills or shadows, separate surfaces.",
      "One primary action, a near-white pill.",
      "Weak evidence looks weak: dim, cool, small, low glow."
    ],
    "rules": [
      { "name": "The Data-Only Chroma Rule", "body": "Hue means evidence strength and nothing else. Buttons, links, nav, focus and hover are white-alpha.", "section": "colors" },
      { "name": "The Unreported Is Gray Rule", "body": "Missing data never borrows a ramp color.", "section": "colors" },
      { "name": "The Meta Contrast Rule", "body": "Anything the reader must read is #8a8f98 or lighter on the surfaces; #62666d is for things that may be missed.", "section": "colors" },
      { "name": "The Lightness-Not-Bold Rule", "body": "Rank text by stepping down the text ramp and by 400/510/590. Do not add 600+ weights or new sizes to create emphasis.", "section": "typography" },
      { "name": "The Mono Means Identifier Rule", "body": "Mono is for point numbers and coordinates, which must read identically on brain, list and detail card.", "section": "typography" },
      { "name": "The One Shadow Rule", "body": "Only surfaces that float over the stage carry the soft drop shadow. Cards, rows and tags never do.", "section": "elevation" }
    ],
    "dos": [
      "Do rank text with the ramp #f7f8f8 to #8a8f98 and weights 400/510/590.",
      "Do separate surfaces with 5% or 8% white inset rings.",
      "Do derive point color, size and glow from the same strength value so weak evidence reads weak.",
      "Do keep point numbers identical on brain, list and detail card, in mono.",
      "Do keep meta text at #8a8f98 or lighter.",
      "Do keep the association-not-proof note visible beside the composer."
    ],
    "donts": [
      "Don't use a hue outside the evidence ramp for chrome, links, buttons or focus.",
      "Don't put a drop shadow on ordinary cards, rows or tags.",
      "Don't use #62666d for text that carries information.",
      "Don't use a light surface, gradient imagery or illustrations; the only gradient is the legend bar.",
      "Don't paint an unreported weight with a ramp color.",
      "Don't use serif outside assistant replies, or mono outside identifiers and coordinates."
    ]
  }
}
